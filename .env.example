# HTTP-сервер
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Логирование
LOG_LEVEL=info
LOG_FORMAT=json

# Ограничитель запросов
RATE_LIMIT_RPS=1000
RATE_LIMIT_BURST=5000

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=users-avatars
MINIO_USE_SSL=false